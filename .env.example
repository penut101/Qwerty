# Discord application token. Never commit the real token.
DISCORD_TOKEN=

# The same Qwerty application is installed in both of these servers.
MAIN_GUILD_ID=
RECRUITMENT_GUILD_ID=

# Private staff channel that receives anonymous PNM questions.
ANONYMOUS_QUESTIONS_CHANNEL_ID=

# Private join-log destination and role that triggers the PNM form.
PNM_JOIN_LOG_CHANNEL_ID=
PNM_ATTENDANCE_LOG_CHANNEL_ID=1536778474755334235
PNM_ONBOARDING_ROLE=PNM

# Members with this exact role name can manage calendar and attendance.
RECRUITMENT_ADMIN_ROLE=Recruitment Team

# Transition members with this role. Using a role prevents accidental mass DMs.
TRANSITION_SOURCE_ROLE=PNM

# Permanent or appropriately long-lived invite to the main server.
MAIN_SERVER_INVITE_URL=

# Role assigned after an invited PNM voluntarily joins the main server.
MAIN_NEW_MEMBER_ROLE=New Member

# Existing main-server Google Sheets attendance integration.
SHEET_ID=
MAIN_ATTENDANCE_CREDENTIALS=qwerty-attendance-credentials.json

# Discord user ID that receives main-server absence reports by DM.
ABSENCE_ADMIN_USER_ID=

# IANA timezone used for calendar entries and attendance timestamps.
QWERTY_TIMEZONE=America/New_York

# Local runtime data directory.
QWERTY_DATA_DIR=data
